---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="ExpoJuy 2026"
  description="ExpoJuy 2026: conectando países, creando oportunidades. Feria de comercio exterior en San Salvador de Jujuy, del 9 al 12 de octubre de 2026."
>
  <section class="contenedor" style="padding-block: var(--space-9);">
    <h1>ExpoJuy 2026</h1>
    <p>Conectando países, creando oportunidades.</p>
    <p style="margin-top: var(--space-4); color: var(--color-texto);">
      Estructura base y contenido de muestra ya definidos — header, footer,
      tokens de diseño y Content Collections. La home completa llega en el
      próximo bloque.
    </p>
  </section>
</BaseLayout>
