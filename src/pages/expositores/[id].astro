---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import RubroIcon from '@/components/icons/RubroIcon.astro';
import DatoIcon from '@/components/icons/DatoIcon.astro';
import { withBase } from '@/utils/url';
import { formatearDia } from '@/utils/fecha';
import { mapearRuedasDeNegociosPorRubro } from '@/utils/ruedasDeNegocios';

export async function getStaticPaths() {
  const expositores = await getCollection('expositores');
  return expositores.map((expositor) => ({
    params: { id: expositor.id },
    props: { expositor },
  }));
}

const { expositor } = Astro.props;
const rubros = await getCollection('rubros');
const rubro = rubros.find((r) => r.data.id === expositor.data.rubro)?.data;

const otrosDelRubro = (await getCollection('expositores'))
  .filter((e) => e.data.rubro === expositor.data.rubro && e.id !== expositor.id)
  .sort((a, b) => a.data.nombre.localeCompare(b.data.nombre, 'es'))
  .slice(0, 3);

const ruedaDeNegocios = mapearRuedasDeNegociosPorRubro(await getCollection('agenda'))[expositor.data.rubro];

// El código de sector ("A-01") separa letra de sector y número de stand,
// para mostrarlos como dos datos distintos (ver DECISIONES.md).
const [letraSector, numeroStand] = expositor.data.sector.split('-');
---

<BaseLayout
  title={expositor.data.nombre}
  description={expositor.data.descripcionBreve}
>
  <section class="contenedor ficha-expositor">
    <nav class="ficha-expositor__migas" aria-label="Ruta de navegación">
      <a href={withBase('/expositores')}>Expositores</a> / <span>{expositor.data.nombre}</span>
    </nav>

    <div class="ficha-expositor__encabezado">
      <h1>{expositor.data.nombre}</h1>
      {rubro && (
        <a class="ficha-expositor__categoria" href={`${withBase('/expositores')}?rubro=${rubro.id}`}>
          {rubro.nombre}
        </a>
      )}
    </div>

    <div class="ficha-expositor__contacto">
      <span class="ficha-expositor__dato">
        <DatoIcon tipo="pais" class="ficha-expositor__dato-icono" />
        {expositor.data.pais}
      </span>
      {ruedaDeNegocios && (
        <span class="ficha-expositor__dato">
          <DatoIcon tipo="fecha" class="ficha-expositor__dato-icono" />
          Rueda de negocios: {formatearDia(ruedaDeNegocios.dia)}
        </span>
      )}
      {expositor.data.web && (
        <a class="ficha-expositor__dato ficha-expositor__dato--enlace" href={expositor.data.web} rel="noopener">
          <DatoIcon tipo="web" class="ficha-expositor__dato-icono" />
          Sitio web
        </a>
      )}
    </div>

    <div class="ficha-expositor__cajas">
      <div class="ficha-expositor__caja">
        <span class="ficha-expositor__caja-etiqueta">Sector</span>
        <span class="ficha-expositor__caja-valor">{letraSector}</span>
      </div>
      <div class="ficha-expositor__caja">
        <span class="ficha-expositor__caja-etiqueta">N.° de stand</span>
        <span class="ficha-expositor__caja-valor">{numeroStand}</span>
      </div>
    </div>

    <div class="ficha-expositor__cuerpo">
      <div class="ficha-expositor__principal">
        <h2>Sobre la empresa</h2>
        <p>{expositor.data.descripcionBreve}</p>
      </div>

      <aside class="ficha-expositor__aside" aria-labelledby="titulo-rubro-relacionado">
        {rubro && (
          <a class="ficha-expositor__rubro" href={`${withBase('/expositores')}?rubro=${rubro.id}`}>
            <RubroIcon icono={rubro.icono} class="ficha-expositor__rubro-icono" />
            <span>
              <span id="titulo-rubro-relacionado" class="ficha-expositor__rubro-etiqueta">Rubro</span>
              <span class="ficha-expositor__rubro-nombre">{rubro.nombre}</span>
            </span>
          </a>
        )}

        {otrosDelRubro.length > 0 && (
          <div class="ficha-expositor__relacionados">
            <h2>Otras empresas del rubro</h2>
            <ul>
              {otrosDelRubro.map((otro) => (
                <li>
                  <a href={withBase(`/expositores/${otro.id}`)}>{otro.data.nombre}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .ficha-expositor {
    padding-block: var(--space-7) var(--space-9);
  }

  .ficha-expositor__migas {
    display: flex;
    align-items: center;
    font-size: var(--texto-sm);
    color: var(--color-texto);
    margin-bottom: var(--space-6);
  }

  .ficha-expositor__migas a {
    display: inline-flex;
    align-items: center;
    min-height: var(--area-tactil-min);
  }

  .ficha-expositor__encabezado {
    margin-bottom: var(--space-4);
  }

  .ficha-expositor__categoria {
    display: inline-flex;
    align-items: center;
    min-height: var(--area-tactil-min);
    margin-top: var(--space-2);
    font-weight: var(--peso-semibold);
    color: var(--color-enlace);
    text-decoration: none;
  }

  .ficha-expositor__contacto {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-borde-ui);
    border-bottom: 1px solid var(--color-borde-ui);
    margin-bottom: var(--space-6);
  }

  .ficha-expositor__dato {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--area-tactil-min);
    color: var(--color-texto);
    font-weight: var(--peso-semibold);
  }

  .ficha-expositor__dato--enlace {
    color: var(--color-enlace);
    text-decoration: none;
  }

  /* :global(): DatoIcon/RubroIcon renderizan su propio <svg> raíz, ver DECISIONES.md */
  :global(.ficha-expositor__dato-icono) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-purpura);
    flex-shrink: 0;
  }

  .ficha-expositor__cajas {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  .ficha-expositor__caja {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    background: var(--color-fondo-alterno);
    border-left: 4px solid var(--color-violeta);
    min-width: 9rem;
  }

  .ficha-expositor__caja-etiqueta {
    font-size: var(--texto-sm);
    font-weight: var(--peso-semibold);
    color: var(--color-texto);
  }

  .ficha-expositor__caja-valor {
    font-size: var(--texto-xl);
    font-weight: var(--peso-bold);
    color: var(--color-titulo);
  }

  .ficha-expositor__cuerpo {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-8);
  }

  .ficha-expositor__principal h2 {
    margin-bottom: var(--space-3);
  }

  .ficha-expositor__principal p {
    color: var(--color-texto);
    max-width: 60ch;
  }

  .ficha-expositor__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .ficha-expositor__rubro {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-fondo-alterno);
    text-decoration: none;
  }

  :global(.ficha-expositor__rubro-icono) {
    width: 2rem;
    height: 2rem;
    color: var(--color-purpura);
    flex-shrink: 0;
  }

  .ficha-expositor__rubro-etiqueta {
    display: block;
    font-size: var(--texto-sm);
    color: var(--color-texto);
  }

  .ficha-expositor__rubro-nombre {
    display: block;
    font-weight: var(--peso-bold);
    color: var(--color-titulo);
  }

  .ficha-expositor__relacionados h2 {
    font-size: var(--texto-md);
    margin-bottom: var(--space-3);
  }

  .ficha-expositor__relacionados ul {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-borde-ui);
    padding-top: var(--space-3);
  }

  .ficha-expositor__relacionados a {
    display: inline-flex;
    align-items: center;
    min-height: var(--area-tactil-min);
  }

  @media (max-width: 767px) {
    .ficha-expositor__cuerpo {
      grid-template-columns: 1fr;
    }

    .ficha-expositor__cajas {
      flex-wrap: wrap;
    }
  }
</style>
