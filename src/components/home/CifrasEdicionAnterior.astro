---
const cifras = [
  { valor: '120+', etiqueta: 'empresas expositoras', campo: 'violeta' },
  { valor: '15', etiqueta: 'países participantes', campo: 'purpura' },
  { valor: '3.200', etiqueta: 'visitantes', campo: 'turquesa' },
  { valor: '180', etiqueta: 'rondas de negocios concretadas', campo: 'lila' },
];
---

<section class="contenedor cifras" aria-labelledby="titulo-cifras">
  <h2 id="titulo-cifras">La edición anterior, en números</h2>
  <div class="cifras__grilla">
    {cifras.map((c) => (
      <div class={`cifras__item cifras__item--${c.campo}`}>
        <span class="cifras__valor">{c.valor}</span>
        <span class="cifras__etiqueta">{c.etiqueta}</span>
      </div>
    ))}
  </div>
  <p class="cifras__nota">Cifras de muestra, ilustrativas para este prototipo.</p>
</section>

<style>
  .cifras {
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-borde-ui);
  }

  .cifras h2 {
    margin-bottom: var(--space-6);
  }

  .cifras__grilla {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .cifras__item {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-2);
    min-height: 10.5rem;
    padding: var(--space-5);
  }

  .cifras__item--violeta {
    background: var(--color-violeta);
    color: var(--color-blanco);
  }

  .cifras__item--purpura {
    background: var(--color-purpura);
    color: var(--color-blanco);
  }

  .cifras__item--turquesa {
    background: var(--color-turquesa);
    color: var(--color-oscuro);
  }

  .cifras__item--lila {
    background: var(--color-lila);
    color: var(--color-oscuro);
  }

  .cifras__valor {
    font-size: var(--texto-2xl);
    font-weight: var(--peso-bold);
    line-height: 1;
    color: inherit;
  }

  .cifras__etiqueta {
    color: inherit;
    font-size: var(--texto-sm);
    max-width: 16ch;
  }

  .cifras__nota {
    margin-top: var(--space-5);
    font-size: var(--texto-sm);
    color: var(--color-texto);
    font-style: italic;
  }

  @media (max-width: 767px) {
    .cifras__grilla {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 479px) {
    .cifras__grilla {
      grid-template-columns: 1fr;
    }
  }
</style>
