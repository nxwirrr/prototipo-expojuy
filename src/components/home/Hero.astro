---
import { withBase } from '@/utils/url';
---

<section class="hero superficie-oscura">
  <div class="contenedor hero__interior">
    <div class="hero__texto">
      <p class="hero__fecha">9 al 12 de octubre de 2026 · Ciudad Cultural, San Salvador de Jujuy</p>
      <h1>ExpoJuy 2026</h1>
      <p class="hero__bajada">Conectando países, creando oportunidades.</p>
      <div class="hero__acciones">
        <a class="boton boton--primario" href={withBase('/entradas')}>Comprar entradas</a>
        <a class="boton boton--secundario" href={withBase('/expositores-info')}>Ser expositor</a>
      </div>
    </div>

    <svg
      class="hero__grafico"
      viewBox="0 0 320 320"
      aria-hidden="true"
      role="presentation"
    >
      <defs>
        <clipPath id="hero-curva">
          <path d="M24 176 a112 112 0 0 0 224 0 Z" />
        </clipPath>
      </defs>

      <rect x="24" y="24" width="88" height="56" fill="var(--color-turquesa)" />
      <rect x="128" y="24" width="56" height="88" fill="var(--color-purpura)" />
      <rect x="24" y="96" width="56" height="56" fill="var(--color-violeta)" />

      <g clip-path="url(#hero-curva)">
        <rect x="24" y="176" width="224" height="112" fill="#c9a46a" />
        <path d="M24 288 L24 232 L70 198 L110 220 L150 184 L188 214 L248 176 L248 288 Z" fill="#8b4a2b" />
        <path d="M24 288 L24 250 L62 214 L98 236 L136 206 L176 228 L210 196 L248 220 L248 288 Z" fill="#c46b4a" />
        <path d="M24 288 L24 262 L78 236 L118 252 L158 228 L198 248 L248 230 L248 288 Z" fill="#d9a06a" />
        <path d="M24 288 L54 268 L96 278 L140 258 L186 274 L248 256 L248 288 Z" fill="#6b8f4e" />
        <rect x="24" y="176" width="224" height="36" fill="var(--color-lila)" />
      </g>
    </svg>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
  }

  .hero__interior {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: var(--space-8);
    padding-block: var(--space-9);
    min-height: 560px;
  }

  .hero__fecha {
    font-weight: var(--peso-semibold);
    color: var(--color-acento-oscuro);
    margin-bottom: var(--space-4);
  }

  .hero h1 {
    font-size: var(--texto-3xl);
    margin-bottom: var(--space-3);
  }

  .hero__bajada {
    font-size: var(--texto-lg);
    color: var(--color-texto-oscuro-tenue);
    max-width: 32ch;
    margin-bottom: var(--space-6);
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .hero__grafico {
    width: 100%;
    height: auto;
    max-width: 320px;
    justify-self: center;
  }

  @media (max-width: 1199px) {
    .hero__interior {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-block: var(--space-8) var(--space-7);
    }

    .hero__grafico {
      order: -1;
      max-width: 220px;
    }
  }

  @media (max-width: 479px) {
    .hero__acciones {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
