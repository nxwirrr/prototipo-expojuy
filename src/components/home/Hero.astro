---
import { withBase } from '@/utils/url';
---

<section class="hero superficie-oscura">
  <div class="contenedor hero__interior">
    <div class="hero__texto">
      <p class="hero__fecha">9 al 12 de octubre de 2026 · Ciudad Cultural, San Salvador de Jujuy</p>
      <h1>ExpoJuy 2026</h1>
      <p class="hero__bajada">Conectando países, creando oportunidades.</p>
      <div class="hero__acciones">
        <a class="boton boton--primario" href={withBase('/entradas')}>Comprar entradas</a>
        <a class="boton boton--secundario" href={withBase('/expositores-info')}>Ser expositor</a>
      </div>
    </div>

    <!--
      Reconstrucción del isologo oficial: rectángulo turquesa,
      rectángulo púrpura, barra violeta y U lila. No es un
      semicírculo lleno — esa lectura deformaba la marca.
    -->
    <svg
      class="hero__grafico"
      viewBox="0 0 240 280"
      aria-hidden="true"
      role="presentation"
    >
      <rect x="0" y="0" width="108" height="64" fill="var(--color-turquesa)" />
      <rect x="0" y="80" width="108" height="64" fill="var(--color-purpura)" />
      <rect x="132" y="0" width="52" height="144" fill="var(--color-violeta)" />
      <path
        d="M0 168 v28 a92 92 0 0 0 184 0 v-28 h-40 v28 a52 52 0 0 1 -104 0 v-28 z"
        fill="var(--color-lila)"
      />
    </svg>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
  }

  .hero__interior {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: var(--space-8);
    padding-block: var(--space-9);
    min-height: 560px;
  }

  .hero__fecha {
    font-weight: var(--peso-semibold);
    color: var(--color-acento-oscuro);
    margin-bottom: var(--space-4);
  }

  .hero h1 {
    font-size: var(--texto-3xl);
    margin-bottom: var(--space-3);
  }

  .hero__bajada {
    font-size: var(--texto-lg);
    color: var(--color-texto-oscuro-tenue);
    max-width: 32ch;
    margin-bottom: var(--space-6);
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .hero__grafico {
    width: 100%;
    height: auto;
    max-width: 280px;
    justify-self: center;
  }

  @media (max-width: 1199px) {
    .hero__interior {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-block: var(--space-8) var(--space-7);
    }

    .hero__grafico {
      order: -1;
      max-width: 200px;
    }
  }

  @media (max-width: 479px) {
    .hero__acciones {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
