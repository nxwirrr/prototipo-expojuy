---
import { withBase } from '@/utils/url';
---

<section class="hero superficie-oscura">
  <div class="contenedor hero__interior">
    <div class="hero__texto">
      <p class="hero__fecha">9 al 12 de octubre de 2026 · Ciudad Cultural, San Salvador de Jujuy</p>
      <h1>ExpoJuy 2026</h1>
      <p class="hero__bajada">Conectando países, creando oportunidades.</p>
      <div class="hero__acciones">
        <a class="boton boton--primario" href={withBase('/entradas')}>Comprar entradas</a>
        <a class="boton boton--secundario" href={withBase('/expositores-info')}>Ser expositor</a>
      </div>
    </div>

    <svg
      class="hero__grafico"
      viewBox="0 0 1080 1080"
      aria-hidden="true"
      role="presentation"
    >
      <rect fill="#756aaf" x="688.4" y="39" width="210.6" height="524.2" />
      <path
        fill="#bba4ce"
        fill-rule="evenodd"
        d="M534.4,1041c-112.1,0-199-30.9-260.8-92.6-61.7-61.7-92.6-143.9-92.6-246.6s.6-26.5,1.7-40.4h211.4c-.7,9.8-1.1,19.5-1.1,29.1,0,50.9,12,90.7,36,119.4,24,28.7,59.6,43.1,106.7,43.1,97.1,0,147.8-63.9,152.3-191.6h210.9v29.1c0,111.2-32,197.4-96.1,258.6-64.1,61.2-153.6,91.9-268.5,91.9"
      />
      <rect fill="#74459a" x="182.7" y="352.6" width="353" height="210.6" />
      <rect fill="#00bdd1" x="182.7" y="39" width="353" height="210.6" />
    </svg>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
  }

  .hero__interior {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: var(--space-8);
    padding-block: var(--space-9);
    min-height: 560px;
  }

  .hero__fecha {
    font-weight: var(--peso-semibold);
    color: var(--color-acento-oscuro);
    margin-bottom: var(--space-4);
  }

  .hero h1 {
    font-size: var(--texto-3xl);
    margin-bottom: var(--space-3);
  }

  .hero__bajada {
    font-size: var(--texto-lg);
    color: var(--color-texto-oscuro-tenue);
    max-width: 32ch;
    margin-bottom: var(--space-6);
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .hero__grafico {
    width: 100%;
    height: auto;
    max-width: 320px;
    justify-self: center;
  }

  @media (max-width: 1199px) {
    .hero__interior {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-block: var(--space-8) var(--space-7);
    }

    .hero__grafico {
      order: -1;
      max-width: 220px;
    }
  }

  @media (max-width: 479px) {
    .hero__acciones {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
