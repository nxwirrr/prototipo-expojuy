---
import { getCollection } from 'astro:content';
import { withBase } from '@/utils/url';
import FaqLista from '@/components/FaqLista.astro';

const faq = (await getCollection('faq')).slice(0, 6).map((f) => f.data);
---

<section class="contenedor faq" aria-labelledby="titulo-faq">
  <div class="faq__encabezado">
    <h2 id="titulo-faq">Preguntas frecuentes</h2>
    <a href={`${withBase('/contacto')}#faq`}>Ver todas las preguntas</a>
  </div>

  <FaqLista items={faq} />
</section>

<style>
  .faq {
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-borde-ui);
  }

  .faq__encabezado {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }
</style>
